{
	"name": "@schubergphilis/sbp-frontend-style",
	"version": "1.14.0",
	"license": "MIT",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		"types": "./dist/index.d.ts",
		"import": "./dist/esm/index.mjs.js",
		"require": "./dist/cjs/index.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"url": "git://github.com/schubergphilis/sbp-frontend-style.git"
	},
	"scripts": {
		"predev": "pnpm prebuild",
		"dev": "vite --port 3005",
		"prebuild": "node --trace-warnings component-list.js",
		"lint": "eslint ./src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview",
		"clean": "rimraf dist",
		"build": "pnpm clean && tsc -p tsconfig.declarations.json && rollup -c",
		"release": "standard-version",
		"test": "jest --coverage --colors --silent --verbose --watchAll=false",
		"test:debug": "jest --watchAll --coverage --color --detectOpenHandles --silent false --verbose true --debug",
		"test:focus": "jest -i ./__tests__/helpers/FunctionHelpers.test.ts -t --watchAll --coverage --color --detectOpenHandles --silent false --verbose true --debug",
		"coverage": "open -a \"Google Chrome\" ./coverage/index.html",
		"test:clear": "jest --clearCache"
	},
	"peerDependencies": {
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"dependencies": {
		"@rollup/plugin-terser": "^1.0.0",
		"styled-components": "6.4.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^9.39.2",
		"@inrupt/jest-jsdom-polyfills": "^4.1.0",
		"@reduxjs/toolkit": "^2.11.2",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-sucrase": "^5.1.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/react-redux": "^7.1.34",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/styled-components": "^5.1.36",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitejs/plugin-react-swc": "^4.3.0",
		"directory-tree": "^3.6.0",
		"eslint": "9.39.2",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.5.0",
		"html-react-parser": "^6.0.1",
		"jest": "^30.3.0",
		"jest-environment-jsdom": "^30.3.0",
		"jest-environment-node": "^30.3.0",
		"prettier": "^3.8.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-element-to-jsx-string": "^17.0.1",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.14.2",
		"react-syntax-highlighter": "^16.1.1",
		"rimraf": "^6.1.3",
		"rollup": "^4.60.2",
		"rollup-plugin-delete": "^3.0.2",
		"rollup-plugin-dts": "^6.4.1",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-tsconfig-paths": "^1.5.2",
		"standard-version": "^9.5.0",
		"ts-jest": "^29.4.9",
		"typescript": "6.0.3",
		"vite": "^8.0.9",
		"vite-tsconfig-paths": "^6.1.1",
		"web-vitals": "^5.2.0"
	},
	"release": {
		"branches": [
			"main"
		]
	},
	"jest": {
		"preset": "ts-jest/presets/default-esm",
		"testEnvironment": "jest-environment-node",
		"coverageReporters": [
			"json",
			"html"
		],
		"coverageProvider": "v8",
		"transform": {
			"node_modules/variables/.+\\.(j|t)sx?$": "ts-jest",
			"^.+\\.(ts|tsx|js|jsx)?$": [
				"ts-jest",
				{
					"useESM": true,
					"tsconfig": {
						"jsx": "react-jsx"
					}
				}
			]
		},
		"moduleFileExtensions": [
			"js",
			"mjs",
			"cjs",
			"esm",
			"jsx",
			"ts",
			"tsx"
		],
		"moduleNameMapper": {
			"\\.(css|less|sass|scss)$": "<rootDir>/__mocks__/styleMock.ts",
			"component-list.json": "<rootDir>/src/component-list.json",
			"^components/(.*)": "<rootDir>/src/components/$1",
			"^datatypes/(.*)": "<rootDir>/src/datatypes/$1",
			"^helpers/(.*)": "<rootDir>/src/helpers/$1",
			"^hooks/(.*)": "<rootDir>/src/hooks/$1",
			"^modules/(.*)": "<rootDir>/src/modules/$1",
			"^store/(.*)": "<rootDir>/src/store/$1",
			"^styling/(.*)": "<rootDir>/src/styling/$1"
		},
		"transformIgnorePatterns": [
			"node_modules/(?!(variables|react-syntax-highlighter)/)"
		]
	}
}
