{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"declarationDir": "./dist/types",
		"emitDeclarationOnly": true,
		"rootDir": "./src",
		"allowImportingTsExtensions": false,
		"noEmit": false,
		"baseUrl": "./src",
		"ignoreDeprecations": "6.0"
	},
	"include": ["src"]
}
